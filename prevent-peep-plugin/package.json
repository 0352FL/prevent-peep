{
  "name": "prevent-peep-plugin",
  "version": "0.352.0",
  "description": "一个防止小鲸鱼乱翻你的文件夹的插件。每次访问你不可见人的文件夹时会弹出警报。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "tools",
    "assets",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "guard", "privacy"],
  "engines": { "node": ">=22" },
  "license": "MIT",
  "scripts": { "test": "node test/guard.test.mjs" }
}