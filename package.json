{
  "name": "prevent-peep",
  "version": "0.4.0",
  "description": "一个防止小鲸鱼乱翻你的文件夹的插件。每次访问你不可见人的文件夹时会弹出警报。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "assets",
    "lib",
    "locale",
    "tools",
    "cordis.patch.yml",
    "大肥鱼我真该控制你了！.cmd",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "guard",
    "privacy",
    "allowlist",
    "sandbox"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/guard.test.mjs"
  }
}